# Required for stable sessions in production. Generate a long random value.
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
FLASK_ENV=development
SESSION_COOKIE_SECURE=false

# Search / AI providers (keys stay on the server)
SEARCH_API_KEY=
SEARCH_API_PROVIDER=auto
# AI provider keys stay server-side. Do NOT put them in HTML/JS.
# AI_API_KEY is kept for backwards compatibility. Prefer provider-specific keys below.
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=groq/compound
AI_API_PROVIDER=groq
GEMINI_API_KEY=
AI_PROVIDER_ORDER=groq
AI_FALLBACK_ENABLED=true

# Optional image generation for Teddy (server-side only)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
AI_MODEL=qwen/qwen3.6-27b
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
ANTHROPIC_MODEL=claude-sonnet-4-6
# Normal Teddy questions go directly to the configured LLM. Web search is optional.

# Google OAuth
# Add these values from your Google Cloud OAuth Web Application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: exact OAuth callback URL registered in Google Cloud.
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Comma-separated email(s) allowed to view /admin/users
ADMIN_EMAILS=your-email@example.com

# Optional: custom SQLite database location
# STUDENT_HUB_DB_PATH=./student_hub.db
